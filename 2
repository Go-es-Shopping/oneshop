<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>訂單管理</title>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            theme: {
                screens: {
                    'md': '800px',  // 涵蓋 800px - 1279px 的平板尺寸
                    'xl': '1280px', // 涵蓋 1280px 以上的桌機尺寸
                }
            }
        }
    </script>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            background-color: #f1f5f9; /* 淺灰藍底色，對應第一張圖背景 */
        }
        
        /* 自訂滾動條樣式，讓寬表格滾動時更美觀 */
        .custom-scrollbar::-webkit-scrollbar {
            height: 8px;
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen p-3 md:p-6 xl:p-8">

    <div class="max-w-[1600px] mx-auto">
        
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4 md:mb-6 gap-4">
            <h1 class="text-2xl md:text-3xl font-bold text-gray-800 tracking-wider">訂單管理</h1>
            <!-- 調整匯出訂單按鈕顏色為柔和的 slate 色系，手機版自動變為滿版 -->
            <button class="bg-slate-600 hover:bg-slate-700 text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors flex items-center justify-center gap-2 shadow-sm w-full md:w-auto">
                <i class="fa-solid fa-file-export"></i>
                匯出訂單
            </button>
        </div>

        <!-- Main Card Container -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            
            <!-- Tabs -->
            <div class="flex w-full overflow-x-auto border-b border-gray-200 custom-scrollbar bg-gray-50/50 text-gray-600 font-medium text-sm">
                <button class="flex-1 min-w-[100px] text-center px-2 py-4 bg-gray-200 text-gray-800 whitespace-nowrap transition-colors">全部</button>
                <button class="flex-1 min-w-[100px] text-center px-2 py-4 hover:bg-gray-100 whitespace-nowrap transition-colors">處理中</button>
                <button class="flex-1 min-w-[100px] text-center px-2 py-4 hover:bg-gray-100 whitespace-nowrap transition-colors">待出貨</button>
                <button class="flex-1 min-w-[100px] text-center px-2 py-4 hover:bg-gray-100 whitespace-nowrap transition-colors">已出貨</button>
                <button class="flex-1 min-w-[100px] text-center px-2 py-4 hover:bg-gray-100 whitespace-nowrap transition-colors">已送達</button>
                <button class="flex-1 min-w-[100px] text-center px-2 py-4 hover:bg-gray-100 whitespace-nowrap transition-colors">完成取貨</button>
                <button class="flex-1 min-w-[100px] text-center px-2 py-4 hover:bg-gray-100 whitespace-nowrap transition-colors">已取消</button>
            </div>

            <!-- Table Container -->
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-sm text-left whitespace-nowrap">
                    <thead class="text-xs text-gray-600 uppercase bg-gray-100/80">
                        <tr>
                            <th scope="col" class="px-4 py-4 font-semibold">訂單主鍵</th>
                            <th scope="col" class="px-4 py-4 font-semibold">購買人姓名</th>
                            <th scope="col" class="px-4 py-4 font-semibold">購買人電話</th>
                            <th scope="col" class="px-4 py-4 font-semibold">購買人 Email</th>
                            <th scope="col" class="px-4 py-4 font-semibold">完整收件地址</th>
                            <th scope="col" class="px-4 py-4 font-semibold">訂單處理狀態</th>
                            <th scope="col" class="px-4 py-4 font-semibold">訂單總金額</th>
                            <th scope="col" class="px-4 py-4 font-semibold">支付狀態</th>
                            <th scope="col" class="px-4 py-4 font-semibold">廣告來源標籤</th>
                            <th scope="col" class="px-4 py-4 font-semibold">建立時間</th>
                            <th scope="col" class="px-4 py-4 font-semibold">更新時間</th>
                            <th scope="col" class="px-4 py-4 font-semibold text-center sticky right-0 bg-gray-100/80 shadow-[-4px_0_6px_-2px_rgba(0,0,0,0.05)]">操作</th>
                        </tr>
                    </thead>
                    <tbody id="table-body" class="divide-y divide-gray-100 bg-white">
                        <!-- Table rows will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>
            
            <!-- Pagination (Mock) -->
            <div class="px-6 py-4 flex items-center justify-between border-t border-gray-100 text-sm text-gray-500 bg-gray-50/30">
                <div id="pagination-info">顯示 0 筆訂單</div>
                <div class="flex gap-1">
                    <button class="px-3 py-1 border border-gray-200 rounded hover:bg-gray-100 disabled:opacity-50" disabled>上一頁</button>
                    <button class="px-3 py-1 border border-gray-200 rounded bg-blue-50 text-blue-600 font-medium">1</button>
                    <button class="px-3 py-1 border border-gray-200 rounded hover:bg-gray-100 disabled:opacity-50" disabled>下一頁</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Map OrderStatus INT to Label and Tailwind Color Classes
        function getOrderStatusBadge(statusInt) {
            const statusMap = {
                0: { label: '處理中', dot: 'bg-blue-400', bg: 'bg-blue-50', text: 'text-blue-700' },
                1: { label: '待出貨', dot: 'bg-yellow-400', bg: 'bg-yellow-50', text: 'text-yellow-700' },
                2: { label: '已出貨', dot: 'bg-purple-400', bg: 'bg-purple-50', text: 'text-purple-700' },
                3: { label: '已送達', dot: 'bg-indigo-400', bg: 'bg-indigo-50', text: 'text-indigo-700' },
                4: { label: '完成取貨', dot: 'bg-green-500', bg: 'bg-green-50', text: 'text-green-700' },
                5: { label: '已取消', dot: 'bg-red-500', bg: 'bg-red-50', text: 'text-red-700' }
            };
            const s = statusMap[statusInt] || { label: '未知狀態', dot: 'bg-gray-400', bg: 'bg-gray-50', text: 'text-gray-700' };
            return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium ${s.bg} ${s.text}">
                        <span class="w-1.5 h-1.5 rounded-full ${s.dot}"></span>
                        ${s.label}
                    </span>`;
        }

        // Map PaymentStatus INT to Label and Tailwind Color Classes
        function getPaymentStatusBadge(statusInt) {
            const statusMap = {
                0: { label: '未付款', dot: 'bg-gray-400', bg: 'bg-gray-100', text: 'text-gray-700' },
                1: { label: '已付款', dot: 'bg-teal-500', bg: 'bg-teal-50', text: 'text-teal-700' },
                2: { label: '退款中', dot: 'bg-orange-400', bg: 'bg-orange-50', text: 'text-orange-700' },
                3: { label: '已退款', dot: 'bg-red-400', bg: 'bg-red-50', text: 'text-red-700' },
                4: { label: '失敗', dot: 'bg-rose-600', bg: 'bg-rose-50', text: 'text-rose-700' }
            };
            const s = statusMap[statusInt] || { label: '未知', dot: 'bg-gray-400', bg: 'bg-gray-100', text: 'text-gray-700' };
            return `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium ${s.bg} ${s.text}">
                        <span class="w-1.5 h-1.5 rounded-full ${s.dot}"></span>
                        ${s.label}
                    </span>`;
        }

        function renderTable(orderData) {
            const tbody = document.getElementById('table-body');
            tbody.innerHTML = '';

            // 處理空資料或未載入的情況 (12 是目前的欄位數量)
            if (!orderData || orderData.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="12" class="px-4 py-12 text-center text-gray-500 bg-gray-50/50">
                            <div class="flex flex-col items-center justify-center">
                                <i class="fa-solid fa-inbox text-3xl text-gray-300 mb-3"></i>
                                <p>目前尚無訂單資料</p>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            orderData.forEach(order => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50/80 transition-colors group';
                
                // Formatting currency
                const formatter = new Intl.NumberFormat('zh-TW', {
                    style: 'currency',
                    currency: 'TWD',
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                });

                // Handle null UTM
                const utmDisplay = order.UTM_Source ? 
                    `<span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs border border-gray-200">${order.UTM_Source}</span>` : 
                    `<span class="text-gray-400 italic text-xs">無</span>`;

                tr.innerHTML = `
                    <td class="px-4 py-4 font-medium text-gray-900">#${order.OrderID || '-'}</td>
                    <td class="px-4 py-4">${order.BuyerName || '-'}</td>
                    <td class="px-4 py-4 font-mono text-gray-600">${order.BuyerPhone || '-'}</td>
                    <td class="px-4 py-4 text-gray-600">${order.BuyerEmail || '-'}</td>
                    <td class="px-4 py-4">
                        <div class="truncate max-w-[200px]" title="${order.BuyerAddress || ''}">
                            ${order.BuyerAddress || '-'}
                        </div>
                    </td>
                    <td class="px-4 py-4">${getOrderStatusBadge(order.OrderStatus)}</td>
                    <td class="px-4 py-4 font-semibold text-gray-800">${formatter.format(order.TotalAmount || 0)}</td>
                    <td class="px-4 py-4">${getPaymentStatusBadge(order.PaymentStatus)}</td>
                    <td class="px-4 py-4">${utmDisplay}</td>
                    <td class="px-4 py-4 text-xs text-gray-500">${order.CreatedAt || '-'}</td>
                    <td class="px-4 py-4 text-xs text-gray-500">${order.UpdatedAt || '-'}</td>
                    <td class="px-4 py-4 sticky right-0 bg-white group-hover:bg-gray-50/80 shadow-[-4px_0_6px_-2px_rgba(0,0,0,0.05)] transition-colors">
                        <div class="flex items-center justify-center gap-3 text-gray-400">
                            <!-- 加入查看明細的連結按鈕 -->
                            <a href="order_detail.html?orderId=${order.OrderID}" class="hover:text-emerald-600 transition-colors cursor-pointer" title="查看明細"><i class="fa-solid fa-eye text-lg"></i></a>
                            <button class="hover:text-blue-600 transition-colors cursor-pointer" title="編輯訂單"><i class="fa-regular fa-pen-to-square text-lg"></i></button>
                            <button class="hover:text-red-500 transition-colors cursor-pointer" title="刪除訂單"><i class="fa-regular fa-trash-can text-lg"></i></button>
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // 模擬後端 API 呼叫的非同步函式 (供後端工程師參考與替換)
        async function fetchOrders() {
            // 顯示載入中狀態
            const tbody = document.getElementById('table-body');
            tbody.innerHTML = `<tr><td colspan="12" class="px-4 py-12 text-center text-gray-500"><i class="fa-solid fa-spinner fa-spin mr-2"></i>資料載入中...</td></tr>`;

            try {
                // TODO: 後端工程師請將這裡替換為實際的 fetch 呼叫
                // const response = await fetch('/api/orders?page=1&status=all');
                // if (!response.ok) throw new Error('Network response was not ok');
                // const data = await response.json(); // 假設回傳陣列
                
                await new Promise(resolve => setTimeout(resolve, 800)); // 模擬網路延遲
                
                // 清空假資料，保留空陣列以觸發「無資料」畫面
                const data = []; 

                renderTable(data);
                
                // 更新分頁資訊 (若後端有回傳總筆數)
                document.getElementById('pagination-info').innerText = `顯示 ${data.length} 筆訂單`;

            } catch (error) {
                console.error('取得訂單資料失敗:', error);
                tbody.innerHTML = `<tr><td colspan="12" class="px-4 py-12 text-center text-red-500">資料載入失敗，請檢查網路連線或稍後再試。</td></tr>`;
            }
        }

        // Initialize table on load
        window.addEventListener('DOMContentLoaded', () => {
            fetchOrders();
            // 後端工程師可以在這裡綁定上方 Tabs 的點擊事件，重新呼叫 fetchOrders(帶入不同狀態參數)
        });
    </script>
</body>
</html>
