<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>電商數據與追蹤設定</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- 針對需求設定專屬的 RWD 斷點 -->
    <script>
        tailwind.config = {
            theme: {
                // 自定義斷點：會覆蓋預設值，確保只在這些區間發生變化
                screens: {
                    'md': '800px',   // 800px - 1279px (平板)
                    'lg': '1280px',  // 1280px+ (桌面)
                }
            }
        }
    </script>

    <!-- 引入 Google Fonts: Noto Sans TC 確保中文字體美觀 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', 'Noto Sans TC', sans-serif;
            background-color: #F4F5F7; /* 稍微帶點藍灰的淺色背景 */
        }
        
        /* 自定義轉換率箭頭形狀 (利用 clip-path) */
        .conversion-arrow {
            clip-path: polygon(0% 0%, 85% 0%, 100% 50%, 85% 100%, 0% 100%);
            /* 讓文字在箭頭內居中偏左，避開尖端 */
            padding-right: 15%; 
        }

        /* 隱藏捲軸但保留滑動功能 (針對小螢幕圖表) */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* 自定義訊息框動畫 */
        @keyframes slideIn {
            from { transform: translateY(-100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .toast-enter {
            animation: slideIn 0.3s ease-out forwards;
        }
    </style>
</head>

<body class="text-slate-800 antialiased min-h-screen p-4 md:p-8 lg:p-10">

    <div class="max-w-7xl mx-auto">
        <!-- 頁面標題 -->
        <h1 class="text-2xl md:text-3xl font-bold mb-6 md:mb-8 text-slate-800 tracking-wide">數據看板</h1>

        <!-- 響應式網格佈局：大螢幕時左右並排，中小螢幕時上下堆疊 -->
        <div class="flex flex-col lg:flex-row gap-6 md:gap-8">
            
            <!-- 卡片 1：轉換率分析 (漏斗圖) - 在大螢幕佔 2/3 寬度 -->
            <div class="w-full lg:w-2/3 bg-white rounded-xl shadow-sm border border-slate-200/60 p-5 md:p-8">
                <h2 class="text-lg md:text-xl font-bold mb-6 md:mb-8 text-slate-800">轉換率分析</h2>

                <!-- 圖表外框：在小螢幕時允許橫向捲動以維持圖表比例 -->
                <div class="w-full overflow-x-auto hide-scrollbar">
                    <!-- 將格線與長條圖整合在同一個相對定位的容器中，確保完美重疊且不會被擠壓 -->
                    <div class="min-w-[750px] h-[340px] relative mt-4">
                        
                        <!-- 背景 Y 軸與水平格線 (置於底層 z-0) -->
                        <div class="absolute inset-0 flex flex-col justify-between pb-[40px] z-0">
                            <!-- 100 -->
                            <div class="flex items-center w-full h-0">
                                <span class="w-10 text-right pr-3 text-xs md:text-sm text-slate-400">100</span>
                                <div class="flex-1 border-b border-dashed border-slate-200"></div>
                            </div>
                            <!-- 80 -->
                            <div class="flex items-center w-full h-0">
                                <span class="w-10 text-right pr-3 text-xs md:text-sm text-slate-400">80</span>
                                <div class="flex-1 border-b border-dashed border-slate-200"></div>
                            </div>
                            <!-- 60 -->
                            <div class="flex items-center w-full h-0">
                                <span class="w-10 text-right pr-3 text-xs md:text-sm text-slate-400">60</span>
                                <div class="flex-1 border-b border-dashed border-slate-200"></div>
                            </div>
                            <!-- 40 -->
                            <div class="flex items-center w-full h-0">
                                <span class="w-10 text-right pr-3 text-xs md:text-sm text-slate-400">40</span>
                                <div class="flex-1 border-b border-dashed border-slate-200"></div>
                            </div>
                            <!-- 20 -->
                            <div class="flex items-center w-full h-0">
                                <span class="w-10 text-right pr-3 text-xs md:text-sm text-slate-400">20</span>
                                <div class="flex-1 border-b border-dashed border-slate-200"></div>
                            </div>
                            <!-- 0 -->
                            <div class="flex items-center w-full h-0">
                                <span class="w-10 text-right pr-3 text-xs md:text-sm text-slate-400">0</span>
                                <div class="flex-1 border-b border-solid border-slate-300"></div>
                            </div>
                        </div>

                        <!-- 長條圖與箭頭主體區塊 (置於上層 z-10) -->
                        <div class="absolute inset-0 z-10 flex items-end pl-[50px] pr-4 pb-[40px]">
                            
                            <!-- 階段 1：造訪網頁 -->
                            <!-- 加入 relative，讓底部的文字可以針對長條圖進行絕對定位 -->
                            <div class="relative flex-1 flex flex-col items-center justify-end h-full group">
                                <span class="mb-2 text-sm font-medium text-slate-600 transition-transform group-hover:-translate-y-1">98</span>
                                <div class="w-14 md:w-20 bg-[#D4DEED] rounded-t-md transition-all duration-300 group-hover:opacity-80 group-hover:shadow-md" style="height: 98%;"></div>
                                <span class="absolute -bottom-8 text-sm text-slate-600 font-medium whitespace-nowrap">造訪網頁</span>
                            </div>

                            <!-- 轉換箭頭 1 -->
                            <div class="w-16 md:w-20 flex justify-center h-full items-center">
                                <div class="conversion-arrow bg-slate-200 text-slate-600 text-xs font-semibold py-2 px-1 md:px-3 w-full text-center shadow-sm z-20">
                                    75.27%
                                </div>
                            </div>

                            <!-- 階段 2：商品瀏覽 -->
                            <div class="relative flex-1 flex flex-col items-center justify-end h-full group">
                                <span class="mb-2 text-sm font-medium text-slate-600 transition-transform group-hover:-translate-y-1">70</span>
                                <div class="w-14 md:w-20 bg-[#B0BDD1] rounded-t-md transition-all duration-300 group-hover:opacity-80 group-hover:shadow-md" style="height: 70%;"></div>
                                <span class="absolute -bottom-8 text-sm text-slate-600 font-medium whitespace-nowrap">商品瀏覽</span>
                            </div>

                            <!-- 轉換箭頭 2 -->
                            <div class="w-16 md:w-20 flex justify-center h-full items-center">
                                <div class="conversion-arrow bg-slate-200 text-slate-600 text-xs font-semibold py-2 px-1 md:px-3 w-full text-center shadow-sm z-20">
                                    75.71%
                                </div>
                            </div>

                            <!-- 階段 3：加入購物車 -->
                            <div class="relative flex-1 flex flex-col items-center justify-end h-full group">
                                <span class="mb-2 text-sm font-medium text-slate-600 transition-transform group-hover:-translate-y-1">53</span>
                                <div class="w-14 md:w-20 bg-[#8C9BB0] rounded-t-md transition-all duration-300 group-hover:opacity-80 group-hover:shadow-md" style="height: 53%;"></div>
                                <span class="absolute -bottom-8 text-sm text-slate-600 font-medium whitespace-nowrap">加入購物車</span>
                            </div>

                            <!-- 轉換箭頭 3 -->
                            <div class="w-16 md:w-20 flex justify-center h-full items-center">
                                <div class="conversion-arrow bg-slate-200 text-slate-600 text-xs font-semibold py-2 px-1 md:px-3 w-full text-center shadow-sm z-20">
                                    64.15%
                                </div>
                            </div>

                            <!-- 階段 4：進入結帳頁 -->
                            <div class="relative flex-1 flex flex-col items-center justify-end h-full group">
                                <span class="mb-2 text-sm font-medium text-slate-600 transition-transform group-hover:-translate-y-1">34</span>
                                <div class="w-14 md:w-20 bg-[#6B7A8F] rounded-t-md transition-all duration-300 group-hover:opacity-80 group-hover:shadow-md" style="height: 34%;"></div>
                                <span class="absolute -bottom-8 text-sm text-slate-600 font-medium whitespace-nowrap">進入結帳頁</span>
                            </div>

                            <!-- 轉換箭頭 4 -->
                            <div class="w-16 md:w-20 flex justify-center h-full items-center">
                                <div class="conversion-arrow bg-slate-200 text-slate-600 text-xs font-semibold py-2 px-1 md:px-3 w-full text-center shadow-sm z-20">
                                    44.12%
                                </div>
                            </div>

                            <!-- 階段 5：完成結帳 -->
                            <div class="relative flex-1 flex flex-col items-center justify-end h-full group">
                                <span class="mb-2 text-sm font-medium text-slate-600 transition-transform group-hover:-translate-y-1">15</span>
                                <div class="w-14 md:w-20 bg-[#4F5C6E] rounded-t-md transition-all duration-300 group-hover:opacity-80 group-hover:shadow-md" style="height: 15%;"></div>
                                <span class="absolute -bottom-8 text-sm text-slate-600 font-medium whitespace-nowrap">完成結帳</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 卡片 2：廣告與追蹤碼設定 - 在大螢幕佔 1/3 寬度 -->
            <div class="w-full lg:w-1/3 bg-white rounded-xl shadow-sm border border-slate-200/60 p-5 md:p-8">
                <h2 class="text-lg md:text-xl font-bold mb-6 text-slate-800">廣告與追蹤碼設定</h2>
            
            <form id="trackingForm" onsubmit="return false;" class="space-y-4 md:space-y-5">
                <!-- Facebook Pixel ID -->
                <div class="flex flex-col">
                    <label for="fbPixel" class="text-sm font-semibold text-slate-700 mb-2">Facebook Pixel ID</label>
                    <input type="text" id="fbPixel" placeholder="例如：1234567890123456" 
                           class="w-full border border-slate-300 rounded-md px-4 py-2.5 text-slate-700 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#4F5C6E]/30 focus:border-[#4F5C6E] transition-colors">
                </div>

                <!-- GTM ID -->
                <div class="flex flex-col">
                    <label for="gtmId" class="text-sm font-semibold text-slate-700 mb-2">Google Tag Manager (GTM) ID</label>
                    <input type="text" id="gtmId" placeholder="例如：GTM-A1B2C3D" 
                           class="w-full border border-slate-300 rounded-md px-4 py-2.5 text-slate-700 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#4F5C6E]/30 focus:border-[#4F5C6E] transition-colors">
                </div>

                <!-- GA4 ID -->
                <div class="flex flex-col">
                    <label for="ga4Id" class="text-sm font-semibold text-slate-700 mb-2">Google Analytics 4 (GA4) ID</label>
                    <input type="text" id="ga4Id" placeholder="例如：G-ABC1234XYZ" 
                           class="w-full border border-slate-300 rounded-md px-4 py-2.5 text-slate-700 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#4F5C6E]/30 focus:border-[#4F5C6E] transition-colors">
                </div>

                <!-- 按鈕區塊：依據斷點自適應排列 -->
                <div class="flex flex-col md:flex-row lg:flex-col justify-center items-center gap-3 pt-6 mt-2">
                    <button type="button" onclick="handleSave()" class="w-full md:w-auto lg:w-full flex-1 bg-[#4F5C6E] text-white px-8 py-2.5 rounded-md font-medium text-sm hover:bg-[#3d4856] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#4F5C6E] transition-colors shadow-sm">
                        儲存
                    </button>
                    <button type="button" onclick="handleDiscard()" class="w-full md:w-auto lg:w-full flex-1 bg-white text-[#4F5C6E] border border-[#4F5C6E] px-8 py-2.5 rounded-md font-medium text-sm hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#4F5C6E] transition-colors shadow-sm">
                        捨棄
                    </button>
                </div>
            </form>
        </div>
        
    </div> <!-- 結束 flex 排版容器 -->
</div> <!-- 結束 max-w-7xl 外框容器 -->

<!-- 自訂通知訊息框 (取代 alert) -->
    <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col gap-2"></div>

    <script>
        
        // 自訂訊息框函數
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            // 根據類型設定顏色
            const bgColor = type === 'success' ? 'bg-green-600' : 'bg-slate-700';
            const icon = type === 'success' ? 
                `<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>` : 
                `<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;

            toast.className = `${bgColor} text-white px-4 py-3 rounded-md shadow-lg flex items-center text-sm font-medium toast-enter`;
            toast.innerHTML = `${icon} ${message}`;
            
            container.appendChild(toast);

            // 3秒後自動消失
            setTimeout(() => {
                toast.style.transition = 'opacity 0.3s ease-out, transform 0.3s ease-out';
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-10px)';
                setTimeout(() => {
                    container.removeChild(toast);
                }, 300);
            }, 3000);
        }

        // 模擬儲存動作
        function handleSave() {
            const fb = document.getElementById('fbPixel').value;
            const gtm = document.getElementById('gtmId').value;
            const ga4 = document.getElementById('ga4Id').value;

            // 簡單檢查是否有填寫
            if(!fb && !gtm && !ga4) {
                showToast('請至少填寫一項追蹤碼喔！', 'info');
                return;
            }

            // 實務上這裡會是發送 API 給後端
            console.log('Saving Tracking Codes:', { FB: fb, GTM: gtm, GA4: ga4 });
            showToast('設定已成功儲存！');
        }

        // 模擬捨棄/重置動作
        function handleDiscard() {
            document.getElementById('trackingForm').reset();
            showToast('已捨棄變更並清空表單', 'info');
        }
    </script>
</body>
</html>
